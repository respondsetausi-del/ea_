# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Used to build verification/login links in emails.
# Falls back to the request origin if unset.
NEXT_PUBLIC_SITE_URL=https://eanaptune.vercel.app

# Signup gating. Defaults to "open" when unset.
#   open     — mentors use the dashboard as soon as they register. They still
#              appear under Mentor Signups until approved, but as a record
#              rather than a gate; approving emails them. (current setting)
#   approval — mentor cannot sign in at all until a super admin approves
#   email    — mentor self-verifies via a Brevo link
NEXT_PUBLIC_SIGNUP_MODE=open

# --- Brevo (transactional email) ---
# Create an API v3 key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
# Must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=EA NAPTUNE

# --- Super admin (god-mode) ---
# Comma-separated emails granted super-admin. Logging in with one of these
# auto-grants the is_super_admin flag in the DB.
SUPER_ADMIN_EMAILS=respondsetausi@gmail.com
# Public copy of the allowlist (safe to expose). Lets these admins bypass the
# email-verification gate at login even before the server key is configured.
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=respondsetausi@gmail.com

# --- App server (for the MQTT monitor in the admin panel) ---
# Base URL of the EA NAPTUNE server.ts deployment.
APP_SERVER_URL=https://your-ea-naptune-server.onrender.com
# Must match ADMIN_API_KEY set on the app server (protects /api/admin/*).
ADMIN_API_KEY=your-shared-admin-key
